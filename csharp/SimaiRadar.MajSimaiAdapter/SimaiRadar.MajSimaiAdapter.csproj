<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SimaiRadar.Core/SimaiRadar.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(MajSimaiProject)' == ''">
    <!-- Local development fallback. The Unity integration compiles against Play's
         existing MajSimai source instead of adding this package a second time. -->
    <PackageReference Include="Lingfeng-bbben.MajSimai" Version="2.2.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(MajSimaiProject)' != ''">
    <ProjectReference Include="$(MajSimaiProject)" />
  </ItemGroup>
</Project>
